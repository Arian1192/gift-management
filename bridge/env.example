# Safe local placeholders for the VITO bridge foundation.
# Copy to bridge/.env for local development and replace with real values outside git.
VITO_BASE_URL=https://vito.example.invalid
VITO_API_TOKEN=replace-with-local-vito-token

# Read-only probe settings. Choose the least-sensitive VITO status/health path available.
VITO_PROBE_PATH=/status
VITO_PROBE_TIMEOUT_MS=5000
